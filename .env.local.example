# =====================================================
# 梦之城AI赋能中心 — 环境变量样例
# 复制本文件为 .env.local，按需填入真值。
# 不要把 .env.local 提交到 git。
# =====================================================

# ----- Cat IP Chatbot / OpenAI 兼容 API -----
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----- 会话签名密钥（必填） -----
# 用于对 dcw_user / dcw_member / dcw_role 三个 cookie 做 HMAC-SHA256 签名。
# 未设置或长度 < 32 时，服务启动直接报错，避免"忘了配 = 任意伪造身份"。
# 生成命令：`openssl rand -base64 48`
SESSION_SECRET=

# ----- 管理员账号密码（必填） -----
# 未设置时 /api/admin-login 直接返回 503，不再回退到默认密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ----- 课程视频 CDN（可选） -----
# 视频从 public/courses/ 改为走对象存储时的 base URL。
# 不填：Next.js 继续从 public/courses/ 提供（开发 / 自托管场景）。
# 填上：构建时嵌入客户端 bundle，所有 videoUrl 自动拼上此前缀（生产场景）。
# 腾讯云 COS 公开桶形如 https://dreamcity-1250000000.cos.ap-shanghai.myqcloud.com
NEXT_PUBLIC_COS_BASE_URL=
