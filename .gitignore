# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE & tools
.codebuddy/
*.log
dev.log

# course videos are large; served from Tencent Cloud COS (NOT tracked in git)
public/courses/**/*.mp4

# scratch / experimental
/temp_covers/
/temp_hf_module1/
/temp_video/
/test-generic/
/test-module/

# Docker
.dockerignore

# legacy code
_legacy_fastapi/

# python
__pycache__/
*.pyc
*.pyo
*.db
*.sqlite3

